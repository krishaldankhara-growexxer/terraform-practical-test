# Terraform state files (NEVER commit these)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda zip (auto-generated)
modules/lambda/scheduler.zip

# SSH keys
*.pem

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

